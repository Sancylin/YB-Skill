{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.figma.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@figma/code-connect/figma-types"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["src/figma/**/*.figma.ts"]
}
